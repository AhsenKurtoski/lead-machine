# ============================================================
# Lead Machine - always-on Docker deployment
# Copy this file to deploy/.env and edit every value marked CHANGE ME.
# Never commit deploy/.env.
# ============================================================

# Public hostname, without https:// (Caddy uses it for automatic TLS)
DOMAIN=crm.example.com

# Must match the public hostname, including https://
NEXT_PUBLIC_BASE_URL=https://crm.example.com

NEXT_PUBLIC_APP_NAME="Lead Machine"
NEXT_PUBLIC_TZ="Europe/Rome"

# Required. At least 8 characters; use a long, unique password.
APP_PASSWORD=CHANGE-ME-use-a-long-password

# Optional but recommended: a real contact for OpenStreetMap requests.
OSM_CONTACT_EMAIL=you@example.com

# Optional AI providers (the API works without them; AI endpoints need one).
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional extra geographic source.
GEOAPIFY_API_KEY=
TOMTOM_API_KEY=

# Optional SMTP. Leave empty to write .eml files locally instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# The container always uses the persistent volume at /data.
# Do not point this at the repository database.
# DATABASE_URL=file:/data/lead-machine.db
