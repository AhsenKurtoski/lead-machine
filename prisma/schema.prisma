// ============================================================
// LEAD MACHINE - Schema database (SQLite, locale, gratis)
// Spina dorsale di tutte le funzioni (A->R).
// SQLite non supporta gli enum: gli stati sono String documentate.
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Lead: l'attivita potenziale cliente ---
model Lead {
  id            String   @id @default(cuid())

  // Anagrafica
  name          String
  category      String?  // es. "ristorante", "parrucchiere"
  subcategory   String?

  // Contatti
  phone         String?
  mobile        String?
  whatsapp      String?  // numero in formato internazionale per wa.me, es 393331234567
  email         String?

  // Web presence
  hasWebsite    Boolean  @default(false)
  website       String?
  websiteStatus String?  // "assente" | "vecchio" | "lento" | "non_responsive" | "ok"
  websiteScreenshot String? // path locale dello screenshot (funzione J)

  // Sito demo generato dall'AI (documento HTML completo, salvato in cache)
  demoHtml      String?
  demoHtmlAt    DateTime?
  demoPrompt    String?  // istruzioni personalizzate per l'AI (cosa deve fare il sito)

  // Social
  hasSocial     Boolean  @default(false)
  instagram     String?
  facebook      String?
  tiktok        String?
  lastSocialPost DateTime?

  // Recensioni
  googleRating  Float?
  googleReviews Int?

  // Posizione principale
  addressFull   String?
  city          String?
  postalCode    String?
  lat           Float?
  lng           Float?

  // Scoring (funzione B)
  priorityScore Int      @default(0)   // 0-100
  priorityReason String? // spiegazione del "perche"

  // CRM (funzione C)
  status        String   @default("NUOVO") // NUOVO | CONTATTATO | IN_TRATTATIVA | CLIENTE | SCARTATO
  notes         String?

  // Provenienza dato
  source        String?  // "overpass" | "manuale" | "import_csv"
  osmId         String?  @unique // per dedup (funzione K)

  // Relazioni
  locations     Location[]
  activities    Activity[]
  followUps     FollowUp[]
  appointments  Appointment[]
  messages      GeneratedMessage[]
  receipts      Receipt[]
  verifications Verification[]
  retryQueue    VerificationRetry[]
  emailLogs     EmailLog[]
  tags          Tag[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([priorityScore])
  @@index([category])
}

// --- Sedi multiple (funzione 4: tutte le sedi) ---
model Location {
  id        String  @id @default(cuid())
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  address   String
  city      String?
  lat       Float?
  lng       Float?
  isPrimary Boolean @default(false)
}

// --- Tag/etichette (funzione C) ---
model Tag {
  id     String @id @default(cuid())
  name   String @unique
  color  String @default("#6366f1")
  leads  Lead[]
}

// --- Log attivita / cronologia (funzione R) ---
model Activity {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  type      String   // "nota" | "stato" | "whatsapp" | "email" | "chiamata" | "sistema"
  description String
  createdAt DateTime @default(now())

  @@index([leadId])
}

// --- Follow-up / promemoria (funzione H) ---
model FollowUp {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  dueDate   DateTime
  note      String?
  channel   String?  // "whatsapp" | "email" | "chiamata"
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([dueDate])
  @@index([done])
}

// --- Appuntamenti / calendario (funzione N) ---
model Appointment {
  id        String   @id @default(cuid())
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId    String?
  title     String
  startsAt  DateTime
  endsAt    DateTime?
  notes     String?
  createdAt DateTime @default(now())

  @@index([startsAt])
}

// --- Template messaggi multi-canale e multi-modello (funzioni D, Q) ---
model MessageTemplate {
  id        String   @id @default(cuid())
  name      String
  channel   String   // "whatsapp" | "email"
  subject   String?  // solo email
  body      String   // con variabili nome, categoria, citta...
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Messaggi generati per ogni lead (storico testo pronto) ---
model GeneratedMessage {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  channel   String   // "whatsapp" | "email"
  subject   String?
  body      String
  waLink    String?  // link wa.me precompilato
  aiUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([leadId])
}

// --- Notifiche (funzione P) ---
model Notification {
  id        String   @id @default(cuid())
  type      String   // "nuovo_lead" | "follow_up" | "risposta" | "sistema"
  title     String
  message   String?
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([read])
}

// --- Impostazioni / branding (chiave-valore) ---
model Setting {
  key   String @id
  value String
}

// --- Verifiche dei dati del lead (Fase 3) ---
// Ogni riga dice: per QUALE campo, con quale ESITO, da quale FONTE e QUANDO.
// Cosi l'utente sa sempre se un dato e verificato o solo ipotizzato.
model Verification {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  field     String   // "phone" | "email" | "website" | "address" | "social"
  status    String   // "verificato" | "da_verificare" | "non_raggiungibile" | "non_valido" | "assente"
  source    String?  // "openstreetmap" | "controllo_diretto" | "ricerca_web"
  evidence  String?  // spiegazione leggibile del risultato
  checkedAt DateTime @default(now())

  // Una sola fotografia per lead e campo e' garantita dalla scrittura (una
  // transazione che sostituisce l'intera fotografia del lead, in
  // verify-runner.ts) e NON da un vincolo unique: aggiungerlo qui farebbe
  // fallire `prisma db push` di ogni installazione esistente chiedendo
  // `--accept-data-loss`. L'invariante si verifica dal vivo con
  // `node scripts/probe-verify-concurrency.mjs` (verifiche in parallelo ->
  // una riga per campo) e `npm run check:hygiene` la controlla nel database.
  @@index([leadId])
  @@index([field])
}

// --- Coda dei controlli rinviati per un problema di rete (verifica dati) ---
// Quando un controllo NON si e potuto fare (il resolver DNS non risponde, il
// sito non da nessuna risposta per un errore di rete) il dato resta "da
// verificare" e finisce qui: l'app lo riprova da sola piu tardi, con attese
// crescenti e un numero massimo di tentativi, invece di lasciarlo in sospeso
// per sempre. Ogni riga e un lead + il campo da riprovare (uno per campo).
model VerificationRetry {
  id            String   @id @default(cuid())
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId        String
  field         String   // "email" | "website"
  reason        String?  // perche e rinviato (es. "il resolver DNS non ha risposto")
  attempts      Int      @default(1) // quanti tentativi sono gia stati fatti
  nextAttemptAt DateTime // quando riprovare
  lastError     String?  // ultimo errore tecnico visto (per diagnosi)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([leadId, field])
  @@index([nextAttemptAt])
}

// --- Ricevute di pagamento (prova che il cliente ha pagato) ---
// NON e un documento fiscale: niente aliquote, niente partita IVA, niente sconti.
// Registra semplicemente: chi ha pagato, quanto, come e quando.
model Receipt {
  id          String   @id @default(cuid())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String
  number      String   @unique // es. "RICEVUTA-2026-001"
  description String?  // cosa e stato pagato
  amount      Float    @default(0) // quanto e stato pagato
  method      String   @default("contanti") // contanti | bonifico | carta | altro
  paidAt      DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leadId])
  @@index([paidAt])
}

// --- Log delle email inviate: a chi, con quale stato e chi ha risposto ---
model EmailLog {
  id        String   @id @default(cuid())
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId    String?
  toEmail   String
  toName    String?
  subject   String
  body      String?
  // INVIATO | RISPOSTO | ACCETTATO | RIFIUTATO | RIMBALZATO
  status    String   @default("INVIATO")
  hasReply  Boolean  @default(false)
  source    String?  // "bulk" | "singola"
  sentAt    DateTime @default(now())
  repliedAt DateTime?

  @@index([leadId])
  @@index([status])
  @@index([sentAt])
}

// --- Chiavi API per integrazioni esterne (es. website builder, script, automazioni) ---
model ApiKey {
  id          String    @id @default(cuid())
  name        String    // es. "Website Builder", "Integrazione Esterna"
  keyHash     String    @unique // hash SHA-256 della chiave completa
  keyPrefix   String    // es. "lm_live_ab1234..." (primi caratteri visibili)
  permissions String    @default("read,write") // "read", "read,write", "admin"
  enabled     Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([keyHash])
  @@index([enabled])
}

