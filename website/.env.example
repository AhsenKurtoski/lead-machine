# Base URL for the website
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# App name shown in UI & emails
NEXT_PUBLIC_APP_NAME=Lead Machine

# GitHub repo URL (for links)
NEXT_PUBLIC_GITHUB_REPO=https://github.com/AhsenKurtoski/lead-machine

# Support email
NEXT_PUBLIC_SUPPORT_EMAIL=hello@leadmachine.dev

# Server-side AI key for the /demo free credits (Gemini API key).
# If empty, visitors fall back to BYOK (their own Gemini/Groq keys).
DEMO_AI_KEY=
