{
  "name": "lead-machine",
  "version": "1.1.0",
  "private": false,
  "description": "Open-source local lead generation platform — find, score and contact nearby businesses for free. 100% self-hosted, SQLite + Next.js.",
  "license": "MIT",
  "author": "Ahsen Kurtoski & Lead Machine Contributors",
  "homepage": "https://github.com/AhsenKurtoski/lead-machine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhsenKurtoski/lead-machine.git"
  },
  "bugs": {
    "url": "https://github.com/AhsenKurtoski/lead-machine/issues"
  },
  "keywords": [
    "ahsen-kurtoski",
    "ahsen kurtoski",
    "created by ahsen kurtoski",
    "ahsen kurtoski lead machine",
    "ahsen-studio",
    "lead-machine",
    "lead-generation",
    "crm",
    "openstreetmap",
    "overpass",
    "nextjs",
    "sqlite",
    "prisma",
    "tailwindcss",
    "ai",
    "groq",
    "gemini",
    "whatsapp",
    "email",
    "data-verification",
    "receipts",
    "self-hosted",
    "local-first",
    "small-business",
    "freelancer",
    "i18n",
    "multilingual"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 127.0.0.1",
    "start:public": "next start -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "i18n:check": "node scripts/check-i18n.mjs",
    "i18n:merge": "node scripts/merge-i18n.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "check:auth": "node scripts/check-auth.mjs",
    "smoke:geo": "node scripts/smoke-geo.mjs",
    "perf:check": "node scripts/perf-check.mjs",
    "test": "node scripts/run-tests.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:hygiene": "node --import tsx scripts/check-hygiene.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "qa": "npm run typecheck && npm run lint && npm run i18n:check && npm run check:content && npm run check:hygiene && npm test",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "setup:screenshot": "npm install -D playwright && npx playwright install chromium",
    "screenshots": "node scripts/screenshot.mjs",
    "demo": "node scripts/demo-gif.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "^15.5.29",
    "playwright": "^1.63.0",
    "postcss": "^8.5.32",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^7.1.7",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
