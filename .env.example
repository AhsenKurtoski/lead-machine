# ============================================================
# Lead Machine — environment variables template
#
#   Copy this file to `.env` before starting the app:
#     copy .env.example .env        (Windows  PowerShell / CMD)
#     cp   .env.example .env        (macOS  / Linux     / WSL)
#
#   IMPORTANT — restart the dev server after editing .env
#   (API routes cache process.env at module-load time in Next.js).
# ============================================================

# ------------------------------------------------------------------
# 1. Database  (SQLite by default — zero external services required)
# ------------------------------------------------------------------
# The path is resolved RELATIVE TO the prisma/ folder.
# Use an absolute path (e.g.  "file:/data/lead-machine.db")  on servers
# with persistent volumes or when you want the DB outside the repo.
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------
# 2. Canonical public URL  (used in emails, ICS calendar, deep links)
# ------------------------------------------------------------------
# Leave this as http://localhost:3000 for local development.
# On a real domain, change it to  "https://crm.yourdomain.com"  so that
# quote PDFs, emails and the quote-send feature always link correctly.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Public brand name shown in the navbar and outgoing emails.
NEXT_PUBLIC_APP_NAME="Lead Machine"

# IANA timezone for date/time formatting (defaults to Europe/Rome if unset).
# See https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
NEXT_PUBLIC_TZ="Europe/Rome"

# ------------------------------------------------------------------
# 3. Default research area  (OpenStreetMap, free)
# ------------------------------------------------------------------
# These defaults are used by the  /ricerca  page when there is no
# "default_city"  stored in the  Settings  table yet.
# The seed installs Feltre (BL), Veneto, Italy — change to your town.
NEXT_PUBLIC_SEARCH_LAT="46.0172"
NEXT_PUBLIC_SEARCH_LNG="11.9069"
NEXT_PUBLIC_SEARCH_RADIUS_M="5000"

# OpenStreetMap / Overpass APIs ask for a contact email to be passed in
# the request headers so they can reach you in case of heavy usage.
# This is NOT optional on busy instances — please fill in a real email.
OSM_CONTACT_EMAIL="you@example.com"

# ------------------------------------------------------------------
# 4. AI providers  (all optional — leave empty to disable AI features)
#
# You need AT MOST ONE of GEMINI_API_KEY / GROQ_API_KEY for the AI
# helpers to work. Set BOTH to enable the transparent failover:
# if the first provider errors or has no quota, the other is tried.
#
# Default priority is  AI_ORDER="gemini,groq"  → Gemini first, then Groq.
# NOTE:  "website on Google search" style grounding works ONLY with
# Google Gemini; Groq only does LLM chat completion.
# ------------------------------------------------------------------
AI_ORDER="gemini,groq"

# 4a. Google Gemini (free tier available — recommended)
#     Create a free key here:  https://aistudio.google.com/app/apikey
#     Models:  gemini-2.0-flash  (best default, generous free quota)
#              gemini-1.5-flash  (older, still works great)
#              gemini-2.0-pro    (better quality, paid)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# 4b. Groq  (free tier with very fast inference)
#     Create a free key here:  https://console.groq.com/keys
#     Models:  llama-3.3-70b-versatile  (best default)
#              llama-3.1-8b-instant    (fastest, cheapest)
#              mixtral-8x7b-32768      (multilingual strong)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ------------------------------------------------------------------
# 5. Email / SMTP  (all optional)
#
# If  SMTP_HOST  is empty or commented out,  NO REAL EMAILS ARE SENT.
# Instead, the app will write each "sent" email as a .eml file to
# ./tmp/emails/  so you can inspect them locally. This is the SAFE
# DEFAULT  — perfect for development, demo and Reels recordings.
#
# When you are ready to send real emails, fill in the 4 fields below.
# For Gmail:  create an  "App Password"   (NOT  your normal password).
#             https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------
SMTP_HOST=""                     # e.g.  "smtp.gmail.com"  /  "smtp.brevo.com"
SMTP_PORT="587"                  # 587 = STARTTLS (preferred)   /   465 = implicit TLS
SMTP_USER=""                     # e.g.  "you@gmail.com"
SMTP_PASS=""                     # e.g.  a Gmail App Password
SMTP_FROM=""                     # e.g.  '"DevDuos" <hello@devduos.it>'   (RFC 5322 format)

# ------------------------------------------------------------------
# 6. Extra, optional research providers  (leave empty if you don't care)
# ------------------------------------------------------------------
# Geoapify  (has a free tier) — used as a SECOND data source for the
# research page, alongside the default OpenStreetMap Overpass API.
# Get a free key here:  https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=""

# Playwright screenshot integration  (no env vars needed).
# Install it ONCE with:
#     npm run setup:screenshot
# (downloads Playwright + a bundled Chromium, ~300 MB).

# ------------------------------------------------------------------
# 7. Production / hosting tweaks
# ------------------------------------------------------------------
# HOSTNAME the production server binds to  ("0.0.0.0" on a VPS).
HOSTNAME="0.0.0.0"
PORT=3000

# Set this to  "production"  explicitly on real servers; Next.js does
# this automatically for  next start  but some tooling likes it set.
NODE_ENV=
